# =============================================================================
# Polyant — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the required values.
# AI provider keys, LangSmith, auth, and channel credentials are configured
# per-instance via the admin panel (Settings tab) — not here.
#
# Required for engine: DATABASE_URL, ENCRYPTION_KEY, AUTH_SECRET, AUTH_INTERNAL_SECRET
# Required for web:    AUTH_SECRET, AUTH_INTERNAL_SECRET (mirror the engine values into packages/web/.env.local)
# =============================================================================

# --- Database (PostgreSQL 16 + pgvector) ---
# Full connection string used by the engine (Drizzle ORM).
DATABASE_URL=postgresql://polyant:changeme@localhost:5432/polyant

# Docker Compose creates the DB using these individual vars.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=polyant
POSTGRES_USER=polyant
# The engine accepts an EMPTY password: `POSTGRES_PASSWORD=` is how an operator
# declares an external PostgreSQL on `trust` auth (see config.ts). That does NOT
# apply to the PostgreSQL bundled in docker-compose.yml, which publishes a port
# on the host and therefore requires one — compose fails fast if it is missing.
POSTGRES_PASSWORD=changeme
# Set to "true" only when the DB enforces TLS (e.g. a managed Postgres). Leave
# empty or unset for a local Docker PostgreSQL. The only accepted values are
# "true" and "false" (and empty = unset = off); anything else — "1", "yes",
# "require", "TRUE" — fails validation at boot rather than being coerced.
#
# UPGRADING from 1.0.0: this used to be a coercion in which every non-empty
# value, "false" included, enabled SSL. If you carry POSTGRES_SSL=false against a
# managed Postgres, TLS was on and is now off — set it to "true". See
# docs/UPGRADING.md.
#
# CAVEAT: "true" gives TLS WITHOUT certificate verification
# (rejectUnauthorized: false), so it protects against a passive listener but not
# against an active man-in-the-middle. Verifying the chain needs a CA bundle the
# engine does not accept yet.
POSTGRES_SSL=

# --- HTTP Server (NestJS engine) ---
API_PORT=4000

# --- Encryption ---
# 32-byte hex key for AES-256-GCM encryption of instance secrets and skill env vars.
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# --- Authentication ---
# Shared secret between engine and web for JWT verification (Auth.js JWE).
# Must be identical in both packages. Generate with: openssl rand -hex 32
AUTH_SECRET=

# Auth.js host trust. Required for any self-hosted deployment — including local
# development on http://localhost — and when running behind a reverse proxy
# (Render, Railway, nginx, etc.). Leave at `true` unless you run on a platform
# (e.g. Vercel) that sets the host automatically. Used by the web package, so it
# must also be present in packages/web/.env.local.
AUTH_TRUST_HOST=true

# RBAC is ENFORCED, unconditionally. There is no AUTHZ_ENFORCE switch and no
# shadow mode: undeclared routes and failed permission checks are denied with
# 403, and there is no way to turn that off. The flag that used to exist is gone
# because this file shipped it as `AUTHZ_ENFORCE=false`, which silently reduced
# every permission check to a no-op in installs that copied the sample.

# Comma-separated list of origins allowed to call the engine API (CORS).
# Leave empty in development if engine and web run on the same origin (rewrites).
# In production, set this to the public origin of your web app.
# Example: CORS_ORIGINS=https://app.example.com,https://admin.example.com
# A credentialed wildcard (`*`) is refused at startup — list explicit origins.
CORS_ORIGINS=

# --- Reverse proxy ---
# Number of trusted proxy hops between the engine and the public internet
# (e.g. set to `1` if a single reverse proxy like Render/Railway/nginx sits in
# front of the engine). Controls whether `X-Forwarded-Host` / `X-Forwarded-Proto`
# headers are honored when reconstructing the request URL for the Twilio
# webhook signature check. Accepts an integer hop count or `true`/`false`.
# Leave at `0` (default) if the engine is exposed directly — otherwise
# attackers could spoof Host/Proto and bypass the Twilio HMAC.
# Only relevant for a WhatsApp channel in `authToken` mode, whose inbound
# authentication is the Twilio HMAC over the reconstructed URL. A channel in
# `apiKey` mode is gated by a secret in the webhook path, which no forwarded
# header can influence.
TRUST_PROXY=0

# --- API rate limiting (@nestjs/throttler) ---
# Per-IP throttling on the HTTP API. Defaults: 30 req/min globally, with
# tighter per-route limits (e.g. POST /v1/chat/completions = 20 req/min).
#   - THROTTLE_ENABLED: only the literal `false` disables ALL throttling
#     (global default + every per-route @Throttle override). Useful for
#     parallel dev/eval runs that fire many requests from one IP. Default on.
#   - THROTTLE_TTL_MS:  window for the global default limit. Default 60000.
#   - THROTTLE_LIMIT:   requests per window for the global default. Default 30.
# THROTTLE_ENABLED=false
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=30

# --- Web → Engine URL ---
# URL the Next.js frontend uses to reach the engine API (server-side rewrites).
NEXT_PUBLIC_API_URL=http://localhost:4000

# Internal URL the web's Credentials provider uses to call the engine's
# /api/auth/credentials/verify endpoint (server-side only). Defaults to
# http://localhost:4000. In production, point this at the engine's internal
# address (e.g. http://engine:4000 inside a private network).
INTERNAL_ENGINE_URL=http://localhost:4000

# --- Platform S3 (optional — for persisting conversation attachments) ---
# When configured, file attachments from WhatsApp/Telegram are stored in S3
# and served via the /api/attachments proxy endpoint.
# If not configured, attachments are not persisted across restarts.
PLATFORM_S3_BUCKET=
PLATFORM_S3_REGION=
PLATFORM_S3_ACCESS_KEY_ID=
PLATFORM_S3_SECRET_ACCESS_KEY=

# --- Message coordinator (WhatsApp/Telegram inbound) ---
# Collapses burst fragments into one pipeline run and cancels/restarts the
# in-flight pipeline when new fragments arrive — keeps UX responsive.

# DEFAULTS for three per-AGENT behaviours. Each agent may set its own
# (Settings → Behaviour overrides); these apply to an agent that sets none.
#
# Pre-pipeline coalescing window (ms). Burst fragments within this window
# are concatenated into one call. Default 2000.
MESSAGE_SOFT_DEBOUNCE_MS=2000

# Delay before sending the channel's typing indicator (ms). Starts the
# "typing…" UX a little after the first fragment — humanises the flow.
# Default 1500.
MESSAGE_TYPING_DELAY_MS=1500

# Cap on consecutive cancel-and-restart cycles per conversation. Once
# reached, further fragments accumulate and are flushed after the current
# pipeline completes. Default 3.
MESSAGE_MAX_RESTARTS=3

# --- PDF rendering (markdownToPdf tool) ---
# Caps how many puppeteer pages render in parallel inside the singleton
# Chromium browser. Each page costs ~50-100MB RSS during render — bump up with
# more RAM, down on tight container memory. Default 3.
PDF_CONCURRENCY=3

# --- Agent-to-agent (virtual `agent` channel) ---
# Max wall-clock duration (ms) of a single sub-agent invocation via the
# virtual in-process `agent` channel. On timeout the synthesised tool
# returns an error string to the caller. Default 60000 (60s).
AGENT_CALL_TIMEOUT_MS=60000

# --- MCP client (external Model Context Protocol servers) ---
# Bounds the per-server connect+list-tools round trip so one hung/slow MCP
# server can't stall every turn. On expiry the server is skipped for that
# turn, exactly like a dead server. Default 10000 (10s).
MCP_CONNECT_TIMEOUT_MS=10000

# --- Activity stream (SSE) resource limits ---
# Caps on concurrent subscribers of GET /api/activity-stream/live. Excess
# connections are rejected with HTTP 503 + Retry-After: 60.
#   - SSE_MAX_CONNECTIONS:          global cap across all users. Default 50.
#   - SSE_MAX_CONNECTIONS_PER_USER: per-authenticated-user cap. Default 5. This
#     one is a PLATFORM policy a platform admin may set in the panel (Settings →
#     General); the GLOBAL cap above protects the process and stays here only.
SSE_MAX_CONNECTIONS=50
SSE_MAX_CONNECTIONS_PER_USER=5

# --- Knowledge resource limits ---
# DEFAULT cap on the number of knowledge documents ONE agent may hold. Uploads
# beyond the cap are rejected with HTTP 400; workspace sync reports the refused
# files in the response (refusedCap[]).
#
# The cap is a per-ORGANIZATION entitlement: an organization that sets its own
# (`organizations.knowledge_max_docs_per_agent`) uses that instead, higher or
# lower, without a redeploy. This value is what an organization gets when it
# declares none, and it is also the answer when the agent cannot be resolved —
# a cap fails closed to a number, never to "no limit".
# Default 500.
KNOWLEDGE_MAX_DOCS_PER_INSTANCE=500

# --- Similarity threshold (memory deduplication) ---
# DEFAULT cosine similarity above which a new memory is considered a duplicate.
# Per-AGENT: each agent may set its own (Settings → Behaviour overrides), because
# when two memories are the same fact is a property of that agent's memory.
# Range: 0.0–1.0. Default: 0.90
DEDUP_SIMILARITY_THRESHOLD=0.90

# --- Analytics retention ---
# DEFAULT for a PLATFORM policy: a platform admin may set it in the panel
# (Settings → General), and that value wins. Shortening it DELETES history on the
# next housekeeping run, which is why the panel route is audited.
#
# Daily housekeeping deletes rows older than this many days from `ai_logs`
# and `pipeline_traces`. Both tables grow at one row per LLM call / pipeline
# run, so unbounded retention is not recommended. Default: 90.
ANALYTICS_RETENTION_DAYS=90

# --- Scheduled-task crash safety ---
# On startup, task rows left in `last_run_status='running'` whose `updated_at` is
# older than SCHEDULER_ORPHAN_GRACE_MS are assumed to belong to a process that is
# gone, and are recovered so the task runs again. Rows younger than it are left
# alone: during a rolling deploy the outgoing process may still be legitimately
# running them, and stealing a live run means executing the task twice.
# Default: 900000 (15 minutes).
SCHEDULER_ORPHAN_GRACE_MS=900000
#
# Per-run deadline used when a task declares no `max_run_ms` of its own. Past it,
# the per-tick reaper marks the run failed so a hung run stops blocking the task
# forever. Deliberately generous: reaping a run that is still alive is the worse
# failure of the two, since the row gets re-armed while the old execution keeps
# going. Default: 1800000 (30 minutes).
SCHEDULER_DEFAULT_MAX_RUN_MS=1800000

# --- Logging verbosity ---
# Controls how much the structured/pipeline loggers emit (console + daily log
# files). One of: debug | info | warn | error | silent. Default: info.
#   - debug:  verbose per-step pipeline tracing (LLM call lines, tool-call args,
#             system-prompt length, context load) on top of info
#   - info:   high-value skeleton — request, LLM token/latency, tool results,
#             supervisor + response timing
#   - warn:   suppress info-level lines, keep warnings + errors
#   - error:  errors only
#   - silent: disable all structured logging
# Note: the full system prompt is never logged here. Full-payload inspection is
# the per-instance `debug_enabled` flag, which persists the prompt, the messages
# and the tool definitions for analysis instead of dumping them to stdout.
LOG_LEVEL=info

# --- Base URL ---
# Public base URL of the engine (used for webhook callback URLs, etc.)
BASE_URL=http://localhost:4000

# --- OAuth-per-conversation broker ---
# ctx.oauth + /oauth/:provider/callback let each conversation authorize its OWN
# account on an external service; the engine brokers + encrypts (principal_secrets)
# + refreshes the token. OAuth tools live in plugins (see polyant-oauthdemo-plugin).
# Client credentials are PER-INSTANCE (no env var): set them in instance_secrets
# under <provider>_oauth_client_id / <provider>_oauth_client_secret via
# PUT /api/instances/:slug/secrets. Each provider registers its own callback,
# <BASE_URL>/oauth/<provider>/callback (e.g. http://localhost:4000/oauth/github/callback).

# --- Locale ---
# DEFAULTS, per-AGENT: each agent may set its own timezone and locale (Settings →
# Behaviour overrides), because one serving Italian customers and one serving
# German customers want different formatting.
# Timezone and locale used by the supervisor system prompt to format
# dates/times. Per-instance overrides happen at the prompt level.
DATETIME_TIMEZONE=UTC
DATETIME_LOCALE=en-US

# --- GitHub integration ---
# GitHub Personal Access Token used by gitCloneRepo is stored per-instance in
# instance_secrets.github_token (encrypted). Configure via the admin panel
# Settings tab. No env var required.

# --- Tracing (optional, opt-in) ---
# LangSmith credentials are configured per-instance via the admin panel
# (Settings tab). There is no env var: the three LANGSMITH_* names this file
# used to carry were read by nothing.

# ─── Auth ────────────────────────────────────────────────────────────
# Shared secret used by the web's Credentials provider to call the engine's
# /api/auth/credentials/verify endpoint. Must be identical in engine and web
# .env files. When unset, email/password login is disabled — and it is the only
# sign-in here, so the panel becomes unreachable.
# Generate with: openssl rand -hex 32
AUTH_INTERNAL_SECRET=

# Initial admin user — created on first boot if the users table is empty.
# INITIAL_ADMIN_PASSWORD is REQUIRED to seed the admin: if unset, seeding is
# skipped (no auto-generation) to avoid writing the secret to the engine logs.
# INITIAL_ADMIN_EMAIL is optional (defaults to administrator@local).
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# ─── External plugins ───────────────────────────────────────────────
# Comma-separated ABSOLUTE paths scanned for external plugins, in addition to the
# convention directory (packages/engine/src/plugins/*). Leave empty unless
# self-hosting and loading a plugin from outside the tree. A plugin out of tree
# needs its OWN node_modules — see docs/plugins.md for why a symlink does not
# work. Example: /opt/polyant/plugins,/srv/acme-plugin
PLUGIN_DIRS=

# ─── Panel build (packages/web, build time) ─────────────────────────
# Next reads .env only from packages/web/, never this file: these belong in
# packages/web/.env.local (or the build environment), and they are baked into
# the bundle at build time — changing one needs a rebuild, not a restart.
#   - NEXT_PUBLIC_APP_VERSION:  version shown in the panel's About. Defaults to
#     the version in packages/web/package.json.
#   - NEXT_PUBLIC_APP_REVISION: commit shown beside it. Falls back to GITHUB_SHA
#     (set by GitHub Actions), then to empty.
#   - NEXT_DIST_DIR: build output directory, so the E2E harness can build into
#     its own. Defaults to .next.
# NEXT_PUBLIC_APP_VERSION=
# NEXT_PUBLIC_APP_REVISION=
# NEXT_DIST_DIR=

# ─── Read by the code, but NOT deployment configuration ─────────────
# Named here so they are not discovered by grep. Do not set them in a
# deployment .env:
#   - NODE_ENV:       the platform's own; set by the process manager or the
#                     npm script, and read to refuse debug behaviour in
#                     production (ai-gateway/providers/base.ts, server/main.ts,
#                     agents/tools/mcp/mcp-url-guard.ts).
#   - CI_REQUIRE_DB:  set to 1 in CI only, where an unreachable database must
#                     FAIL the integration tier instead of skipping it.
#   - CDK_STAGE:      selects the stage in infra/config.yaml for the CDK CLI.
#   - GITHUB_SHA:     provided by GitHub Actions; only a fallback for
#                     NEXT_PUBLIC_APP_REVISION above.
#   - PUPPETEER_EXECUTABLE_PATH: puppeteer's own, read by puppeteer and not by
#                     us. Dockerfile.engine sets it to the Alpine chromium; a
#                     path written here would name a binary the image lacks.
