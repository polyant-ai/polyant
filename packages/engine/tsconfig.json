{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "paths": {
      "@/*": ["./src/*"]
    },
    "types": ["vitest/globals"]
  },
  "include": ["src/**/*"],
  // src/plugins holds plugins dropped in for an image build. They are separate
  // packages with their own tsconfig, dependencies and compilation — typechecking
  // them from here reports their deps as missing, because they are not the
  // engine's. The plugins stage of Dockerfile.engine owns their build.
  "exclude": ["node_modules", "dist", "src/plugins"]
}
