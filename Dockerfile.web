# ── Stage 1: Install dependencies ──────────────────────────────
FROM node:22-alpine AS deps
WORKDIR /app
COPY package.json package-lock.json ./
COPY packages/web/package.json packages/web/
# Create minimal engine package.json for workspace resolution
RUN mkdir -p packages/engine && echo '{"name":"@polyant/engine","version":"1.0.0","private":true}' > packages/engine/package.json
RUN npm ci --workspace=@polyant/web --include-workspace-root

# ── Stage 2: Build ─────────────────────────────────────────────
FROM node:22-alpine AS build
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
# npm hoists most deps to the root, but workspace-local deps (e.g. lucide-react)
# land in packages/web/node_modules — copy them too or Turbopack can't resolve them
COPY --from=deps /app/packages/web/node_modules ./packages/web/node_modules
COPY package.json package-lock.json ./
COPY packages/web/ packages/web/

# Engine URL for the Next.js /api rewrites, inlined at build time.
# Default "" = relative paths for gateway-routed topologies (AWS ALB routes
# /api/* to the engine). Deployments where Next itself must proxy to the
# engine (e.g. Render, separate web/engine services) MUST pass the engine
# URL as a build arg — Render injects service env vars as build args when
# they are declared via ARG.
ARG NEXT_PUBLIC_API_URL=""
ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL}
RUN npm run build -w @polyant/web

# ── Stage 3: Runtime ───────────────────────────────────────────
FROM node:22-alpine AS runtime
WORKDIR /app
ENV NODE_ENV=production

# Copy Next.js standalone output. The standalone build does NOT bundle the
# public/ folder nor .next/static — both must be copied next to server.js
# (which lives at packages/web/server.js in a monorepo standalone tree).
COPY --from=build /app/packages/web/.next/standalone ./
COPY --from=build /app/packages/web/.next/static ./packages/web/.next/static
COPY --from=build /app/packages/web/public ./packages/web/public

EXPOSE 3000

# Next.js standalone server.js reads PORT/HOSTNAME at runtime. Without HOSTNAME
# Docker auto-injects the container id, and the server binds to it instead of
# all interfaces → unreachable on the published port. Set it here so the image
# is self-contained (the AWS task def also sets it, but plain `docker run` /
# compose / Render would not).
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

CMD ["node", "packages/web/server.js"]
